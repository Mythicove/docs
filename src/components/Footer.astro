---
import EditLink from "virtual:starlight/components/EditLink";
import LastUpdated from "virtual:starlight/components/LastUpdated";
import Pagination from "virtual:starlight/components/Pagination";

const year = new Date().getFullYear();
const hash = __BUILD_HASH__;
const isEn = (Astro.locals.starlightRoute?.lang ?? "zh-CN").startsWith("en");
const l = isEn
  ? { content: "Content", code: "Site code", build: "Build" }
  : { content: "内容", code: "站点代码", build: "构建" };
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
  <div class="legal">
    <span>© {year} Mythicove</span>
    <a href="https://github.com/Mythicove/docs/blob/main/LICENSE">{l.content} CC BY-SA 4.0</a>
    <a href="https://github.com/Mythicove/docs/blob/main/LICENSE-CODE">{l.code} MIT</a>
    <a href={`https://github.com/Mythicove/docs/commit/${hash}`}>{l.build} <code>{hash}</code></a>
  </div>
</footer>

<style>
  footer {
    flex-direction: column;
    gap: 1.5rem;
  }
  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    row-gap: 0.35rem;
    margin: 1.5rem auto 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    text-align: center;
  }
  /* 宽屏：条目之间用 · 分隔 */
  .legal > * + *::before {
    content: "·";
    margin-inline: 0.5em;
  }
  /* 窄屏：一行一个，去掉分隔符 */
  @media (max-width: 30rem) {
    .legal {
      flex-direction: column;
      align-items: center;
    }
    .legal > * + *::before {
      content: none;
    }
  }
  .legal a {
    color: inherit;
    text-decoration: none;
  }
  .legal a:hover {
    color: var(--sl-color-white);
  }
</style>
