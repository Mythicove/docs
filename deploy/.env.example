# 浏览器访问的站点地址（统一入口模式=对外域名；本地默认网关 http://localhost:8080）
API_URL=http://localhost:8080
# 网关发布端口（compose 的 caddy 服务，统一入口）
API_PORT=8080
# web 直连调试端口（统一入口模式下浏览器流量走网关，此端口仅本地调试）
WEB_PORT=3101
# 前端站点地址（邮件中的验证/重置链接指向这里）。
# 统一入口模式：与 API_URL 相同（同域名）；分离部署：填 Pages 前端域名。
# 同时以 NEXT_PUBLIC_WEB_URL 烘焙进 web 镜像（metadataBase/sitemap/robots 的公开 origin）。
WEB_URL=http://localhost:3101
# Hoard 管理端点的静态令牌（bootstrap/救援通道）。留空**不等于开放**：
# 此时只有 role=admin 的登录会话（HOARD_ADMIN_SUBJECTS 映射）能管理，fail closed。
HOARD_ADMIN_TOKEN=
# 登录即映射为 hoard 管理员的 mirror 用户 ID（逗号分隔）
HOARD_ADMIN_SUBJECTS=

# ---- OIDC SSO 与管理令牌（Mirror 为 IdP，Hoard 为 RP；全部留空 = 禁用 SSO）----
# 浏览器面的 issuer：compose 用它推导 mirror 的 MIRROR_BASE_URL，hoard 校验 iss 必须完全一致。
# 统一入口模式 = 网关对外地址（本地默认 http://localhost:8080）。
#OIDC_ISSUER_URL=http://localhost:8080
# mirror 管理端点静态令牌（注册 OIDC client、批量导入、救援通道）
#MIRROR_ADMIN_TOKEN=
# hoard 侧 RP：client 需先在 mirror 注册（POST /api/admin/oauth-clients，Bearer MIRROR_ADMIN_TOKEN）
#HOARD_OIDC_ISSUER=http://localhost:8080
#HOARD_OIDC_CLIENT_ID=
#HOARD_OIDC_CLIENT_SECRET=
# 回调地址（留空 = HOARD_BASE_URL + /auth/oidc/callback）
#HOARD_OIDC_REDIRECT_URL=http://localhost:8080/auth/oidc/callback
# 服务端侧（discovery/JWKS/token）可达的 IdP 内网基址；compose 默认 http://mirror:8080
# （走浏览器面地址会绕到宿主发布的网关端口 → hoard/caddy 启动互相等待而死锁）
#HOARD_OIDC_INTERNAL_BASE_URL=http://mirror:8080
# web 构建期的站点基址（robots.txt / sitemap / metadataBase）。
# compose 已用 WEB_URL 自动透传，通常无需单独设置；分离部署（前端在 Pages 等）
# 时在 web 的构建环境里设成前端自己的域名。
#NEXT_PUBLIC_WEB_URL=http://localhost:8080

# ---- 验证码（可选；driver 留空则不启用）----
# mirror 侧：MIRROR_CAPTCHA_DRIVER=turnstile|recaptcha|hcaptcha|cap + SECRET + SITE_KEY
# cap（自托管）还需 MIRROR_CAPTCHA_CAP_URL=实例公网地址。
# 注意：driver 配了但缺参数时，mirror 会**拒绝注册**（503）而不是静默放行。
# web 侧：CSP 在构建期烘焙，用 cap 时必须让 web 也知道实例地址（否则控件/WASM 被 CSP 拦掉）。
# 留空则 compose 自动复用 MIRROR_CAPTCHA_CAP_URL。
CAPTCHA_CAP_URL=

# ---- 路由与索引策略（构建期注入 web）----
# never（默认）：所有语言同路径，语言由 cookie + Accept-Language 决定，适合小群体自用；
#   该模式默认输出 meta robots noindex 并屏蔽已知 bot UA（BLOCK_BOTS 可显式覆盖）。
# always：每语言独立 URL（/zh-CN/…、/en/…），配合 INDEXABLE=true 做 SEO 站。
LOCALE_PREFIX=never
INDEXABLE=false
BLOCK_BOTS=

# ---- 裸跑（不用 docker compose）本地开发必备 ----
# 前端 dev server 与 API 不同源，且前端请求带凭据（credentials: include）。
# 浏览器规范禁止「带凭据 + Access-Control-Allow-Origin: *」，未配置时两个后端
# 都会回退为 *，导致 mods/SSO 等全部跨端调用被浏览器拦截。
# 值必须等于前端 dev server 的 origin（含端口，无尾斜杠），多个用逗号分隔。
MIRROR_CORS_ORIGINS=http://localhost:3000
HOARD_CORS_ORIGINS=http://localhost:3000
# docker compose 场景可逗号分隔多个 origin（dev server 与 compose web 并存）：
# MIRROR_CORS_ORIGINS=http://localhost:3100,http://localhost:3101
