# 单 API 域名（浏览器访问的地址；本地默认 http://localhost:8080）
API_URL=http://localhost:8080
API_PORT=8080
WEB_PORT=3101
# 前端站点地址（邮件中的验证/重置链接指向这里）
WEB_URL=http://localhost:3101
# Hoard 上传鉴权 token（留空则开放上传）
HOARD_ADMIN_TOKEN=

# ---- 路由与索引策略（构建期注入 web）----
# never（默认）：所有语言同路径，语言由 cookie + Accept-Language 决定，适合小群体自用；
#   该模式默认输出 meta robots noindex 并屏蔽已知 bot UA（BLOCK_BOTS 可显式覆盖）。
# always：每语言独立 URL（/zh-CN/…、/en/…），配合 INDEXABLE=true 做 SEO 站。
LOCALE_PREFIX=never
INDEXABLE=false
BLOCK_BOTS=

# ---- 裸跑（不用 docker compose）本地开发必备 ----
# 前端 dev server 与 API 不同源，且前端请求带凭据（credentials: include）。
# 浏览器规范禁止「带凭据 + Access-Control-Allow-Origin: *」，未配置时两个后端
# 都会回退为 *，导致 mods/SSO 等全部跨端调用被浏览器拦截。
# 值必须等于前端 dev server 的 origin（含端口，无尾斜杠），多个用逗号分隔。
MIRROR_CORS_ORIGINS=http://localhost:3000
HOARD_CORS_ORIGINS=http://localhost:3000
# docker compose 场景可逗号分隔多个 origin（dev server 与 compose web 并存）：
# MIRROR_CORS_ORIGINS=http://localhost:3100,http://localhost:3101
