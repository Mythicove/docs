# Mythicove 统一入口网关（compose `caddy` 服务加载）。
# 单端口聚合 前端(web) + 皮肤站(mirror) + mod 站(hoard)：
#   宿主反代/TLS 只需把域名整体指到本网关，无需再做路径分流。
# 分离部署（web 部署到 Pages 等独立宿主）时：
#   `docker compose up -d db mirror hoard caddy` 跳过 web 服务，
#   本文件末尾的 web 兜底路由会因上游缺失返回 502（API 路径不受影响），见 docs/deploy。
:8080 {
	# ---- Hoard：Modrinth 兼容 API / SSO 会话 / 团队 / PAT ----
	reverse_proxy /v2/* hoard:8081
	reverse_proxy /api/mods* hoard:8081
	reverse_proxy /auth/* hoard:8081
	reverse_proxy /api/team* hoard:8081
	reverse_proxy /api/user* hoard:8081

	# ---- Web：BFF 会话路由与 GET 落地页（必须先于 mirror 的 /api/*、/account/* 兜底）----
	# /api/auth/*：Next 路由处理器，token 只在服务端经手（httpOnly cookie 会话）
	reverse_proxy /api/auth/* web:3000
	# 邮件落地页 GET 是 web 页面；同名 POST（/account/verify 等）是 mirror API，由下方规则承接
	@web_landing {
		path /account/verify /account/reset-password
		method GET
	}
	reverse_proxy @web_landing web:3000

	# ---- Mirror：Yggdrasil / 账号 / 皮肤库 / 纹理 / 渲染 / 管理 / OIDC Provider ----
	# /metrics 有意不经网关暴露（Prometheus 在 compose 网络内直抓 mirror:8080/hoard:8081）
	@mirror path /authserver/* /sessionserver/* /api/* /account/* /oauth/* /oauth2/* /mojang/* /skinlib* /skin/* /cape/* /textures/* /avatars/* /renders/* /usm/* /MinecraftSkins/* /MinecraftCloaks/* /admin/batch-import /.well-known/openid-configuration /.well-known/jwks.json /healthz
	reverse_proxy @mirror mirror:8080

	# ---- 其余（页面 / _next 静态资源 / favicon 等）→ Web 前端 ----
	reverse_proxy web:3000
}
