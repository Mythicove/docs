# Mythicove 生产反代模板（宿主 Caddy）。
#
# 栈内 caddy 网关已完成 前端/mirror/hoard 的路径分流（见 ./Caddyfile），
# 宿主侧只需把域名整体指向网关发布端口，无需再写任何路径规则。
#
# 用法：
#   export DOMAIN=www.example.com GATEWAY=localhost:8080
#   caddy run --config Caddyfile.prod
# （GATEWAY：宿主 Caddy 用 localhost:${API_PORT}；若宿主 Caddy 与栈同 docker 网络则填 caddy:8080）
#
# 本地验证语法：caddy validate --config Caddyfile.prod --adapter caddyfile
# 前提：域名解析到本机，80/443 可达（Caddy 自动签发/续期 Let's Encrypt）。
# DNS-01（CDN/内网场景）自行加 tls { dns ... }。
#
# 信任边界：Caddy 是应用的可信代理（compose 默认私网可信已覆盖 docker 网络）。
# 若 Caddy 前还有 CDN/云 LB，需在应用侧把边缘网段配进 MIRROR_/HOARD_TRUSTED_PROXIES，
# 否则限流/日志解析到的是边缘 IP。

{$DOMAIN:localhost} {
	encode zstd gzip

	# 安全头兜底（应用层各自也设置；此处保证反代直出的 404/5xx 也带）
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy {$GATEWAY:localhost:8080}
}
